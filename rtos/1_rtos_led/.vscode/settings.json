{
    "C_Cpp.default.configurationProvider": null,
    "C_Cpp.errorSquiggles": "enabled",
    "C_Cpp.intelliSenseEngine": "default",
    "clangd.arguments": [
        "--compile-commands-dir=${workspaceFolder}",
        "--background-index",
        "--header-insertion=never"
    ],
    "files.associations": {
        "*.h": "c",
        "freertos.h": "c",
        "task.h": "c",
        "self_task.h": "c",
        "buzzer.h": "c",
        "bsp_led.h": "c",
        "gd32f4xx.h": "c"
    }
}
